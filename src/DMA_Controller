module DMA_Controller (
    // PHYSICAL BOARD INPUTS (Altera DE2 Cyclone II)
    input wire CLOCK_50,       // 50 MHz physical crystal oscillator clock source
    input wire [15:0] SW,      // 16 hardware toggle switches. 
                               // SW[15:8] = Target Base Address, SW[7:0] = Payload Data
    input wire [1:0] KEY,      // Hardware push-buttons. KEY[1] = Start, KEY[0] = Reset
    
    // PHYSICAL BOARD OUTPUTS
    output wire [6:0] HEX0,    // 7-segment display for the lower nibble (bits 3:0)
    output wire [6:0] HEX1,    // 7-segment display for the upper nibble (bits 7:4)
    output wire [17:0] LEDR    // Visual LED indicators (LEDR[0] mapped to Reset)
);

    // INTERNAL BUSES (Silicon Routing)
    // These wires represent the physical copper paths routed through the FPGA fabric 
    // to connect the instantiated sub-modules.
    wire [7:0] current_address; // The calculated absolute memory location (Base + Offset)
    wire [7:0] fsm_offset;      // The current 0-15 cycle count generated by the FSM
    wire [7:0] memory_out;      // The raw binary data fetched from the M4K RAM block
    wire write_en;              // The critical control signal enabling memory writes
    
    wire clean_start;           // The filtered, debounced start trigger

    // 1. SIGNAL CONDITIONING
    // The DE2 push-buttons (KEY) are active-low (0 when pressed, 1 when unpressed).
    // We invert the signal (~KEY[1]) so the debouncer processes a standard active-high logic pulse.
    debouncer start_debouncer (
        .clk(CLOCK_50),
        .button_in(~KEY[1]), 
        .button_out(clean_start)
    );

    // 2. CONTROL UNIT (The Brain)
    // Orchestrates the DMA transfer timing. It takes the clean start pulse and generates 
    // the write_enable control signal and the sequential offset counter.
    dma_fsm fsm_inst (
        .clk(CLOCK_50),
        .reset(~KEY[0]),        // Active-low physical reset button
        .start_button(clean_start), 
        .write_enable(write_en),
        .offset_out(fsm_offset) // Exports the internal state burst counter
    );

    // 3. ADDRESS GENERATION (The Math & Multiplexing)
    // A hardware multiplexer chooses between the fast FSM counter during an active write burst,
    // and manual switch inputs (SW[3:0]) when the system is resting in IDLE for readback.
    wire [7:0] active_offset = (write_en) ? fsm_offset : {4'b0000, SW[3:0]};

    // A combinational hardware adder that dynamically calculates the absolute memory location.
    address_generator addr_inst (
        .base(SW[15:8]),         
        .offset(active_offset),     
        .final_address(current_address)
    );

    // 4. STORAGE (The Payload)
    // The internal Cyclone II M4K block RAM instantiated to hold the transferred data.
    // The fsm_offset is dynamically added to the static switch data during the burst,
    // guaranteeing every single memory slot receives a completely unique, verifiable value.
    dma_memory mem_inst (
        .clk(CLOCK_50),
        .write_enable(write_en),
        .address(current_address),
        .data_in(SW[7:0] + fsm_offset),        
        .data_out(memory_out)
    );

    // 5. USER INTERFACE (Hex Decoding & Debugging)
    // Translates the raw 8-bit binary output from the memory block into the specific
    // active-low 7-segment masks required to light up the physical DE2 board LEDs.
    hex_decoder hex0_inst (.hex_in(memory_out[3:0]), .seg_out(HEX0));
    hex_decoder hex1_inst (.hex_in(memory_out[7:4]), .seg_out(HEX1));
    
    // Hardware debug routing to visually prove the Active-Low reset pulse reaches the FSM.
    assign LEDR[0] = ~KEY[0];
    
endmodule
